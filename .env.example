# Database configuration (defaults to offline SQLite; switch DB_DIALECT=mysql for MySQL 8.0)
DB_DIALECT=sqlite
DB_SQLITE_PATH=warehouse_fleet.db
DB_MYSQL_DRIVER=pymysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=fleet_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=warehouse_fleet

# MQTT broker configuration (optional live Mosquitto mode)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=fleet_mqtt_user
MQTT_PASS=CHANGE_ME_MQTT_PASSWORD
MQTT_TOPIC=robot/R1/sensor/dht22
